---
import { assetExists } from '../lib/work';
import Artwork from './Artwork.astro';
import Arrow from './Arrow.astro';
import { projectPreviews } from '../data/project-previews';
import '../styles/work.css';

interface Props {
  href: string;
  title: string;
  meta: string[];
  cover: string;
  slug?: string;
  role?: string;
  tags: string[];
  status?: 'live' | 'progress';
  badge?: string;
  index?: number;
}

const { href, title, meta, cover, slug, role, tags, status = 'live', badge, index = 0 } = Astro.props;
const hasCover = assetExists(projectPreviews[slug ?? '']?.src ?? cover);
const isEnglish = href.startsWith('/en');
---

<a class={`card project-card project-card--${index % 4}`} href={href} data-tags={tags.join(' ')} data-reveal style={`--i:${Math.min(index, 3)}`}>
  <div class="card-media" data-tilt>
    {hasCover ? (
      <Artwork slug={slug} cover={cover} alt={title} />
    ) : (
      <div class="card-art-fallback" aria-hidden="true"><span>✳</span></div>
    )}
    <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <span class="card-open" aria-hidden="true"><Arrow /></span>
    {badge ? <span class="card-status">{badge}</span> : status === 'progress' ? <span class="card-status">{isEnglish ? 'In progress' : 'Dalam proses'}</span> : null}
  </div>

  <div class="card-body">
      <span class="card-title">{title}</span>
      <span class="card-meta">{meta.filter(Boolean).join(' / ')}</span>
      {role && <span class="card-role">{role}</span>}
  </div>
</a>
