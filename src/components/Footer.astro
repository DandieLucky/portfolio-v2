---
import Icon from './Icon.astro';
import {ui,href,site,type Lang} from '../i18n/ui';
interface Props{lang:Lang;noCta?:boolean;}
const {lang,noCta=false}=Astro.props;const t=ui[lang];const id=lang==='id';
const socials=[{label:'Email',url:`mailto:${site.email}`},{label:'WhatsApp',url:site.whatsapp},{label:'LinkedIn',url:site.linkedin}];
---
{!noCta&&<section class="creative-cta"><div class="wrap"><div class="cta-panel"><div class="cta-eyeline"><p class="eyebrow">{id?'CERITA BERIKUTNYA, KITA BUAT BERSAMA.':'LET’S MAKE THE NEXT STORY TOGETHER.'}</p><span class="availability"><i aria-hidden="true"></i>{id?'TERBUKA UNTUK KOLABORASI':'OPEN TO COLLABORATE'}</span></div><a class="cta-big-link" href={`mailto:${site.email}`}><h2>{id?'Punya ide?':'Got an idea?'}<br /><em>{id?'Ayo wujudkan.':'Let’s make it real.'}</em></h2><span class="cta-circle" aria-hidden="true"><Icon /></span></a><div class="cta-details"><p>{t.home.ctaBody}</p><a href={`mailto:${site.email}`} class="cta-email">{site.email} <Icon /></a></div></div></div></section>}
<footer class="site-footer"><div class="wrap"><div class="footer-top"><a class="footer-name" href={href('/',lang)}>dandie<span aria-hidden="true"><Icon kind="spark" /></span></a><div class="footer-socials">{socials.map(s=><a href={s.url} target={s.url.startsWith('http')?'_blank':undefined} rel="noopener noreferrer">{s.label} <span aria-hidden="true"><Icon /></span></a>)}<a href={site.cv} download>{t.ui.cv} ↓</a></div></div><div class="footer-bottom"><p>© {new Date().getFullYear()} Dandie Lucky Maulana</p><p>JAKARTA, INDONESIA / {id?'DIBUAT DENGAN RASA INGIN TAHU':'BUILT WITH CURIOSITY'}</p><a href="#main" data-to-top>{t.ui.top} ↑</a></div></div></footer>
