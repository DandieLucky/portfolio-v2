---
import { assetExists } from '../lib/work';
import assets from '../data/assets.json';
import sizes from '../data/asset-meta.json';

interface Item {
  src: string;
  alt: string;
  caption?: string;
  background?: string;
}

interface Props {
  items: Item[];
  columns?: 2 | 3;
  /** rasio asli tiap gambar, bukan dipotong 4:3 */
  natural?: boolean;
}

const { items, columns = 2, natural = false } = Astro.props;

const assetMap = assets as Record<string, boolean>;
const sizeMap = sizes as Record<string, [number, number]>;
const isPlaceholder = (src: string) => assetMap[src.startsWith('/') ? src : `/${src}`] === true;
const strip = (s: string) => (s.startsWith('/') ? s.slice(1) : s);
/** ukuran asli supaya halaman tidak melompat saat gambar dimuat */
const dims = (src: string) => sizeMap[src.startsWith('/') ? src : `/${src}`] ?? [1200, 900];
---

<div
  class:list={[
    'gallery',
    columns === 3 && 'gallery--3',
    natural && 'gallery--natural',
  ]}
>
  {items.map((item) => {
    const clean = strip(item.src);
    const exists = assetExists(item.src);
    return (
      <figure>
        {exists ? (
          <a class="slot-media" href={`/${clean}`} data-lightbox-link aria-label={item.alt} style={item.background ? { background: item.background } : undefined}>
            <img
              src={`/${clean}`}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              width={dims(item.src)[0]}
              height={dims(item.src)[1]}
            />
            {isPlaceholder(item.src) && <span class="asset-flag">slot aset</span>}
          </a>
        ) : (
          <div class="slot" style="min-height:180px">
            <div class="slot-inner">
              <span class="slot-label">Slot aset</span>
              <p><code>public/{clean}</code></p>
            </div>
          </div>
        )}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    );
  })}
</div>
