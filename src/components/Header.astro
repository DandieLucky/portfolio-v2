---
import Icon from './Icon.astro';
import { ui, href, otherLangPath, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t=ui[lang];
const pathname=Astro.url.pathname;
const languagePath=/\/404(?:\.html)?\/?$/.test(pathname)?'/':pathname;
const links=[{path:'/work', label:t.nav.work},{path:'/fotografi',label:t.nav.gallery},{path:'/about',label:t.nav.about},{path:'/lab',label:t.nav.lab},{path:'/contact',label:t.nav.contact}];
const normalized=pathname.replace(/\/$/,'')||'/';
---
<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={href('/',lang)} aria-label={`Dandie Lucky Maulana — ${lang==='id'?'beranda':'home'}`}><span class="brand-mark" aria-hidden="true">d<span><Icon kind="spark" /></span></span><span class="brand-wordmark">dandie<span class="brand-role">VISUAL CREATIVE</span></span></a>
    <nav class="nav" id="site-nav" data-nav aria-label={lang==='id'?'Navigasi utama':'Main navigation'}>{links.map(l=><a href={href(l.path,lang)} aria-current={normalized===href(l.path,lang)||normalized.startsWith(`${href(l.path,lang)}/`)?'page':undefined}>{l.label}<span aria-hidden="true"><Icon /></span></a>)}</nav>
    <div class="header-controls"><button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label={lang==='id'?'Jeda animasi dekoratif':'Pause decorative motion'} title={lang==='id'?'Jeda animasi dekoratif':'Pause decorative motion'}><span aria-hidden="true" data-motion-symbol>Ⅱ</span></button><div class="lang" role="group" aria-label={t.ui.langSwitch}><a href={otherLangPath(languagePath,'id')} aria-current={lang==='id'?'true':'false'} hreflang="id">ID</a><a href={otherLangPath(languagePath,'en')} aria-current={lang==='en'?'true':'false'} hreflang="en">EN</a></div><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">{t.nav.menu}<span aria-hidden="true">☰</span></button></div>
  </div>
</header>
